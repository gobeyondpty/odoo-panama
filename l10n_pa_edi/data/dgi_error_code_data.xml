<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Subset of common DGI error codes with Spanish messages. The
         catalog is open-ended; PAC providers may surface codes not
         listed here, in which case the model falls back to a generic
         "DGI {code} (sin descripción local)" message.

         Codes follow Ficha Técnica PAC nomenclature (E-prefix codes
         are DGI errors; the 4-character family identifies the block
         where the error originated: B=general, E=item, F=totals). -->

    <record id="dgi_error_b06_invalid_doc" model="l10n_pa_edi.dgi.error.code">
        <field name="code">B06</field>
        <field name="severity">error</field>
        <field name="short_message">Tipo de documento inválido</field>
        <field name="description">El campo iDoc no corresponde a un tipo de documento DGI válido (01–09).</field>
    </record>

    <record id="dgi_error_b08_pto_facturacion" model="l10n_pa_edi.dgi.error.code">
        <field name="code">B08</field>
        <field name="severity">error</field>
        <field name="short_message">Punto de facturación inválido</field>
        <field name="description">El punto de facturación (dPtoFacDF) debe ser un número de 3 dígitos.</field>
    </record>

    <record id="dgi_error_b07_nro_df" model="l10n_pa_edi.dgi.error.code">
        <field name="code">B07</field>
        <field name="severity">error</field>
        <field name="short_message">Número de documento fiscal inválido</field>
        <field name="description">El número de documento fiscal (dNroDF) debe ser único en la serie del emisor y de hasta 10 dígitos.</field>
    </record>

    <record id="dgi_error_b15_formcafe" model="l10n_pa_edi.dgi.error.code">
        <field name="code">B15</field>
        <field name="severity">error</field>
        <field name="short_message">Formato de generación del CAFE inválido</field>
        <field name="description">El campo iFormCafe debe estar entre 1 y 3 según la modalidad de entrega configurada.</field>
    </record>

    <record id="dgi_error_1002_doc_duplicado" model="l10n_pa_edi.dgi.error.code">
        <field name="code">1002</field>
        <field name="severity">error</field>
        <field name="short_message">Documento duplicado</field>
        <field name="description">El PAC ya recibió un documento con el mismo identificador; verifique si el envío anterior fue autorizado antes de reintentar.</field>
    </record>

    <record id="dgi_error_1513_nro_df_duplicado" model="l10n_pa_edi.dgi.error.code">
        <field name="code">1513</field>
        <field name="severity">error</field>
        <field name="short_message">Número del documento fiscal duplicado</field>
        <field name="description">El número de documento fiscal ya fue usado en la serie del emisor; el correlativo no puede reiniciarse ni repetirse.</field>
    </record>

    <record id="dgi_error_emisor_ruc" model="l10n_pa_edi.dgi.error.code">
        <field name="code">B201</field>
        <field name="severity">error</field>
        <field name="short_message">RUC del emisor no autorizado</field>
        <field name="description">El RUC del emisor no se encuentra autorizado por DGI para emitir factura electrónica, o su DV no coincide.</field>
    </record>

    <record id="dgi_error_receptor_ruc" model="l10n_pa_edi.dgi.error.code">
        <field name="code">B402</field>
        <field name="severity">error</field>
        <field name="short_message">RUC del receptor inválido</field>
        <field name="description">El RUC del receptor no es válido o el DV no coincide.</field>
    </record>

    <record id="dgi_error_e501_tasa_itbms" model="l10n_pa_edi.dgi.error.code">
        <field name="code">E501</field>
        <field name="severity">error</field>
        <field name="short_message">Tasa ITBMS inválida</field>
        <field name="description">El código de tasa ITBMS (dTasaITBMS) debe ser 00 (exento), 01 (7%), 02 (10%) o 03 (15%).</field>
    </record>

    <record id="dgi_error_f01_total_neto" model="l10n_pa_edi.dgi.error.code">
        <field name="code">F01</field>
        <field name="severity">error</field>
        <field name="short_message">Total neto inconsistente</field>
        <field name="description">La suma de los montos de los ítems no coincide con dTotNeto.</field>
    </record>

    <record id="dgi_error_f02_total_itbms" model="l10n_pa_edi.dgi.error.code">
        <field name="code">F02</field>
        <field name="severity">error</field>
        <field name="short_message">Total ITBMS inconsistente</field>
        <field name="description">La suma de los ITBMS por ítem no coincide con dTotITBMS.</field>
    </record>

    <record id="dgi_error_f03_vtot" model="l10n_pa_edi.dgi.error.code">
        <field name="code">F03</field>
        <field name="severity">error</field>
        <field name="short_message">Total general inconsistente</field>
        <field name="description">dVTot debe ser igual a dTotNeto + dTotITBMS + otros impuestos − descuentos.</field>
    </record>

    <record id="dgi_error_signature" model="l10n_pa_edi.dgi.error.code">
        <field name="code">SIG01</field>
        <field name="severity">error</field>
        <field name="short_message">Firma electrónica inválida</field>
        <field name="description">La firma XAdES del documento no se valida contra el certificado del emisor o de la cadena de confianza.</field>
    </record>
</odoo>
