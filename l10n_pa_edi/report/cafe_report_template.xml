<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- CAFE QWeb template. Per DGI Ficha Técnica iFormCafe=1 (PDF
         estándar). Layout is intentionally simple: header with
         emisor/receptor, line table, totals, and a QR code carrying
         the CUFE so DGI inspectors can verify with a phone scanner. -->
    <template id="report_cafe_document">
        <t t-call="web.external_layout">
            <div class="page">
                        <h2 class="text-center">
                            Electronic Invoice Authorization Certificate (CAFE)
                        </h2>
                        <div class="row">
                            <div class="col-6">
                                <strong>Issuer</strong>
                                <div t-field="o.company_id.name"/>
                                <div>RUC: <t t-out="o.company_id.vat"/>-<t t-out="o.company_id.partner_id.l10n_pa_dv"/></div>
                                <div t-field="o.company_id.partner_id.contact_address_inline"/>
                                <div t-if="o.company_id.l10n_pa_business_activity_code">
                                    Activity: <t t-out="o.company_id.l10n_pa_business_activity_code"/>
                                </div>
                            </div>
                            <div class="col-6">
                                <strong>Recipient</strong>
                                <div t-field="o.commercial_partner_id.name"/>
                                <div t-if="o.commercial_partner_id.vat">
                                    Identification: <t t-out="o.commercial_partner_id.vat"/>
                                    <t t-if="o.commercial_partner_id.l10n_pa_dv">
                                        -<t t-out="o.commercial_partner_id.l10n_pa_dv"/>
                                    </t>
                                </div>
                                <div t-field="o.commercial_partner_id.contact_address_inline"/>
                            </div>
                        </div>
                        <hr/>
                        <div class="row">
                            <div class="col-8">
                                <p>
                                    <strong>Document:</strong>
                                    <span t-field="o.name"/>
                                    <br/>
                                    <strong>Issue Date:</strong>
                                    <span t-field="o.invoice_date"/>
                                    <br/>
                                    <strong>CUFE:</strong>
                                    <span style="font-family: monospace; font-size: 8pt; word-break: break-all;"
                                          t-out="o.l10n_pa_cufe"/>
                                </p>
                            </div>
                            <div class="col-4 text-end">
                                <img t-if="o.l10n_pa_qr_payload or o.l10n_pa_cufe"
                                     t-att-src="o._l10n_pa_get_qr_barcode_src()"
                                     style="max-width: 200px;"/>
                            </div>
                        </div>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Description</th>
                                    <th class="text-end">Qty.</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Subtotal</th>
                                    <th class="text-end">ITBMS</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="idx" t-value="0"/>
                                <t t-foreach="o.invoice_line_ids.filtered(lambda l: l.display_type == 'product')" t-as="line">
                                    <t t-set="idx" t-value="idx + 1"/>
                                    <tr>
                                        <td t-out="idx"/>
                                        <td>
                                            <span t-field="line.name"/>
                                        </td>
                                        <td class="text-end" t-out="'%.4f' % line.quantity"/>
                                        <td class="text-end" t-out="'%.2f' % line.price_unit"/>
                                        <td class="text-end" t-out="'%.2f' % line.price_subtotal"/>
                                        <td class="text-end"
                                            t-out="'%.2f' % (line.price_total - line.price_subtotal)"/>
                                        <td class="text-end" t-out="'%.2f' % line.price_total"/>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <div class="row">
                            <div class="col-6"/>
                            <div class="col-6">
                                <table class="table table-sm">
                                    <tr>
                                        <td>Subtotal</td>
                                        <td class="text-end" t-out="'%.2f' % o.amount_untaxed"/>
                                    </tr>
                                    <tr>
                                        <td>ITBMS</td>
                                        <td class="text-end" t-out="'%.2f' % o.amount_tax"/>
                                    </tr>
                                    <tr>
                                        <td><strong>Total</strong></td>
                                        <td class="text-end"><strong t-out="'%.2f' % o.amount_total"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                        <p class="small text-muted">
                            This document is the printed representation of the
                            electronic invoice issued and authorized by DGI. The
                            original electronic invoice is the associated XML file.
                        </p>
            </div>
        </t>
    </template>

    <template id="report_cafe">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="l10n_pa_edi.report_cafe_document"/>
            </t>
        </t>
    </template>

    <template id="report_invoice_document_inherit_l10n_pa_edi" inherit_id="account.report_invoice_document">
        <xpath expr="//table[@name='invoice_line_table']" position="after">
            <div t-if="o._l10n_pa_show_cafe_on_invoice()"
                 class="mt-3 mb-3 p-0 avoid-page-break-inside"
                 name="l10n_pa_cafe_block">
                <table class="w-100 table-borderless l10n-pa-cafe-summary" style="border-collapse: collapse;">
                    <tr>
                        <td class="l10n-pa-cafe-copy" style="vertical-align: top; padding-right: 16px;">
                            <div class="l10n-pa-cafe-eyebrow">DGI Validation</div>
                            <h6 class="mb-1">Electronic invoice authorized by DGI</h6>
                            <div class="l10n-pa-cafe-note">
                                Scan the QR code or use the CUFE below to validate this invoice
                                in the DGI system.
                            </div>
                            <div class="l10n-pa-cafe-status mt-2">
                                <strong>Status</strong>
                                <span t-field="o.l10n_pa_pac_status"/>
                            </div>
                            <div class="l10n-pa-cafe-cufe mt-2">
                                <strong>CUFE</strong>
                                <span t-out="o.l10n_pa_cufe"/>
                            </div>
                        </td>
                        <td class="l10n-pa-cafe-qr" style="width: 118px; vertical-align: top; text-align: right;">
                            <img t-if="o.l10n_pa_qr_payload or o.l10n_pa_cufe"
                                 t-att-src="o._l10n_pa_get_qr_barcode_src()"
                                 style="width: 112px; height: 112px;"/>
                            <div class="l10n-pa-cafe-qr-label">DGI QR</div>
                        </td>
                    </tr>
                </table>
            </div>
        </xpath>
    </template>
</odoo>
