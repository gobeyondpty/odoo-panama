<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_form_pa_edi" model="ir.ui.view">
        <field name="name">account.move.form.l10n_pa_edi</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_l10n_pa_send_to_pac"
                        type="object"
                        string="Send to DGI"
                        class="btn-primary"
                        invisible="country_code != 'PA' or move_type not in ('out_invoice','out_refund') or l10n_pa_pac_status in ('authorized','cancelled') or state != 'posted'"/>
                <button name="action_l10n_pa_query_status"
                        type="object"
                        string="Check DGI Status"
                        invisible="country_code != 'PA' or not l10n_pa_cufe or l10n_pa_pac_status not in ('sent','rejected')"/>
                <button name="action_l10n_pa_cancel_with_pac"
                        type="object"
                        string="Cancel with DGI"
                        invisible="country_code != 'PA' or l10n_pa_pac_status != 'authorized'"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="DGI Electronic Invoice"
                      name="l10n_pa_edi"
                      invisible="country_code != 'PA' or move_type not in ('out_invoice','out_refund')">
                    <group>
                        <group string="DGI Status">
                            <field name="l10n_pa_pac_status" readonly="1"/>
                            <field name="l10n_pa_cufe" readonly="1"/>
                            <field name="l10n_pa_security_code" readonly="1"/>
                            <field name="l10n_pa_xml_attachment_id" readonly="1"/>
                            <field name="l10n_pa_pac_send_count" readonly="1"/>
                            <field name="l10n_pa_pac_last_attempt" readonly="1"/>
                            <field name="l10n_pa_pac_error_codes" readonly="1"
                                   invisible="not l10n_pa_pac_error_codes"/>
                        </group>
                        <group string="References and Mode">
                            <field name="l10n_pa_origin_cufe"
                                   invisible="move_type not in ('out_refund',)"/>
                            <field name="l10n_pa_contingency"/>
                            <field name="l10n_pa_contingency_reason"
                                   invisible="not l10n_pa_contingency"
                                   required="l10n_pa_contingency"/>
                        </group>
                    </group>
                    <group string="DGI Classification">
                        <field name="l10n_pa_operation_nature"/>
                        <field name="l10n_pa_operation_type"/>
                        <field name="l10n_pa_operation_destination"/>
                    </group>
                    <group string="Raw PAC Response (Debug)">
                        <field name="l10n_pa_pac_response" nolabel="1" readonly="1"/>
                    </group>
                    <group string="PAC History">
                        <field name="l10n_pa_pac_event_ids" nolabel="1">
                            <list>
                                <field name="create_date"/>
                                <field name="operation"/>
                                <field name="state"/>
                                <field name="pac_status_code"/>
                                <field name="pac_status_message"/>
                                <field name="error_codes"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
