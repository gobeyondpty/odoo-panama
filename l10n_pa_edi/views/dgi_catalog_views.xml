<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_pa_edi_location_list" model="ir.ui.view">
        <field name="name">l10n_pa_edi.location.list</field>
        <field name="model">l10n_pa_edi.location</field>
        <field name="arch" type="xml">
            <list string="DGI Locations">
                <field name="code"/>
                <field name="province"/>
                <field name="district"/>
                <field name="township"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_pa_edi_location_form" model="ir.ui.view">
        <field name="name">l10n_pa_edi.location.form</field>
        <field name="model">l10n_pa_edi.location</field>
        <field name="arch" type="xml">
            <form string="DGI Location">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="province"/>
                        <field name="district"/>
                        <field name="township"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_pa_edi_location" model="ir.actions.act_window">
        <field name="name">DGI Locations</field>
        <field name="res_model">l10n_pa_edi.location</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_l10n_pa_edi_cpbs_list" model="ir.ui.view">
        <field name="name">l10n_pa_edi.cpbs.list</field>
        <field name="model">l10n_pa_edi.cpbs</field>
        <field name="arch" type="xml">
            <list string="CPBS Codes">
                <field name="code"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_pa_edi_cpbs_form" model="ir.ui.view">
        <field name="name">l10n_pa_edi.cpbs.form</field>
        <field name="model">l10n_pa_edi.cpbs</field>
        <field name="arch" type="xml">
            <form string="CPBS Code">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_pa_edi_cpbs" model="ir.actions.act_window">
        <field name="name">CPBS Codes</field>
        <field name="res_model">l10n_pa_edi.cpbs</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_l10n_pa_edi_uom_list" model="ir.ui.view">
        <field name="name">l10n_pa_edi.uom.list</field>
        <field name="model">l10n_pa_edi.uom</field>
        <field name="arch" type="xml">
            <list string="Electronic Invoice Units">
                <field name="code"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_pa_edi_uom_form" model="ir.ui.view">
        <field name="name">l10n_pa_edi.uom.form</field>
        <field name="model">l10n_pa_edi.uom</field>
        <field name="arch" type="xml">
            <form string="Electronic Invoice Unit">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_pa_edi_uom" model="ir.actions.act_window">
        <field name="name">Electronic Invoice Units</field>
        <field name="res_model">l10n_pa_edi.uom</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_l10n_pa_edi_catalog_root"
              name="Panama Electronic Invoice Catalogs"
              parent="account.menu_finance_configuration"
              sequence="45"
              groups="account.group_account_manager"/>
    <menuitem id="menu_l10n_pa_edi_location"
              parent="menu_l10n_pa_edi_catalog_root"
              action="action_l10n_pa_edi_location"
              sequence="10"
