<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_partner_form_pa_edi" model="ir.ui.view">
        <field name="name">res.partner.form.l10n_pa_edi</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="l10n_pa_receiver_type"
                       invisible="country_id and country_id.code != 'PA'"/>
            </xpath>
        </field>
    </record>
</odoo>
