<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_factura_facil" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.factura_facil</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='fiscal_localization_setting_container']" position="inside">
                <setting id="l10n_pa_factura_facil_setting"
                         string="Factura Fácil (PAC Panamá)"
                         help="Credenciales y endpoints del PAC Factura Fácil S.A."
                         documentation="">
                    <div class="content-group">
                        <div class="row mt16">
                            <label for="l10n_pa_factura_facil_base_url" class="col-lg-4 o_light_label"/>
                            <field name="l10n_pa_factura_facil_base_url" class="oe_inline"/>
                        </div>
                        <div class="row">
                            <label for="l10n_pa_factura_facil_base_url_prod" class="col-lg-4 o_light_label"/>
                            <field name="l10n_pa_factura_facil_base_url_prod" class="oe_inline"/>
                        </div>
                        <div class="row">
                            <label for="l10n_pa_factura_facil_api_key" class="col-lg-4 o_light_label"/>
                            <field name="l10n_pa_factura_facil_api_key" password="True" class="oe_inline"/>
                        </div>
                        <div class="row">
                            <label for="l10n_pa_factura_facil_timeout" class="col-lg-4 o_light_label"/>
                            <field name="l10n_pa_factura_facil_timeout" class="oe_inline"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
