<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="l10n_pa_vacation_accrual_plan" model="hr.leave.accrual.plan">
        <field name="name">Panama Legal Vacation: 1 day per 11 service days</field>
        <field name="time_off_type_id" ref="l10n_pa_leave_type_vacation"/>
        <field name="transition_mode">immediately</field>
        <field name="accrued_gain_time">end</field>
        <field name="can_be_carryover" eval="True"/>
        <field name="carryover_date">allocation</field>
    </record>

    <record id="l10n_pa_vacation_accrual_level" model="hr.leave.accrual.level">
        <field name="accrual_plan_id" ref="l10n_pa_vacation_accrual_plan"/>
        <field name="milestone_date">creation</field>
        <field name="start_count">0</field>
        <field name="start_type">day</field>
        <field name="frequency">daily</field>
        <field name="added_value">0.09091</field>
        <field name="added_value_type">day</field>
        <field name="cap_accrued_time" eval="True"/>
        <field name="maximum_leave">60.0</field>
        <field name="action_with_unused_accruals">all</field>
        <field name="carryover_options">unlimited</field>
    </record>
</odoo>
