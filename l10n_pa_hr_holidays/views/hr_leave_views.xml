<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_leave_view_form_l10n_pa" model="ir.ui.view">
        <field name="name">hr.leave.view.form.l10n.pa</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form_manager"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='duration_display']" position="after">
                <field name="l10n_pa_legal_vacation_days" invisible="not l10n_pa_legal_vacation_days"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <div class="alert alert-warning" role="alert" invisible="not l10n_pa_vacation_compliance_warning">
                    <field name="l10n_pa_vacation_compliance_warning" nolabel="1"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
