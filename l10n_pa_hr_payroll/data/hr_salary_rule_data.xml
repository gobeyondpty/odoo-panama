<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Statutory citations are in each rule's ``description``. Helpers come
        from ``l10n.pa.hr.payroll.mixin`` so that the math is unit-tested
        independently of Odoo. Rates resolve through ``payslip._rule_parameter('...')``
        so changes propagate by date instead of by code release.
    -->

    <!-- ============================================================ -->
    <!-- PA_REGULAR: monthly payroll                                   -->
    <!-- ============================================================ -->

    <record id="l10n_pa_rule_basic" model="hr.salary.rule">
        <field name="name">Basic Salary</field>
        <field name="code">BASIC</field>
        <field name="struct_id" ref="l10n_pa_payroll_structure_regular"/>
        <field name="category_id" ref="hr_payroll.BASIC"/>
        <field name="sequence">10</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = payslip.paid_amount or version.wage</field>
    </record>

    <record id="l10n_pa_rule_overtime_day" model="hr.salary.rule">
        <field name="name">Overtime Day (CT art. 33 num. 1: +25 %)</field>
        <field name="code">OT_DAY</field>
        <field name="struct_id" ref="l10n_pa_payroll_structure_regular"/>
        <field name="category_id" ref="hr_payroll.ALW"/>
        <field name="sequence">50</field>
        <field name="condition_select">python</field>
        <field name="condition_python">result = bool(inputs.get('OT_DAY_HRS') and inputs['OT_DAY_HRS'].amount)</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = payslip.env['l10n.pa.hr.payroll.mixin'].overtime_pay(categories['BASIC'], inputs['OT_DAY_HRS'].amount, 0.25)</field>
        <field name="note">Recargo del 25 % sobre la jornada ordinaria diurna. CT art. 33 numeral 1. Insumo OT_DAY_HRS = horas extras diurnas.</field>
    </record>

