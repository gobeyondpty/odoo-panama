    <record id="l10n_pa_rule_vacation_pay" model="hr.salary.rule">
        <field name="name">Pago de Vacaciones (CT art. 54)</field>
        <field name="code">VAC_PAY</field>
        <field name="struct_id" ref="l10n_pa_payroll_structure_regular"/>
        <field name="category_id" ref="hr_payroll.ALW"/>
        <field name="sequence">55</field>
        <field name="condition_select">python</field>
        <field name="condition_python">result = bool(inputs.get('VAC_PAY_DAYS') and inputs['VAC_PAY_DAYS'].amount)</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
avg_11m = (inputs.get('VAC_PAY_AVG_11M') and inputs['VAC_PAY_AVG_11M'].amount) or 0.0
base = payslip.env['l10n.pa.hr.payroll.mixin'].vacation_base(avg_11m, version.wage)
result = payslip.env['l10n.pa.hr.payroll.mixin'].vacation_pay(base, inputs['VAC_PAY_DAYS'].amount)
        </field>
        <field name="note">Pago efectivo de vacaciones tomadas. CT art. 54: 30 días = un mes de salario base = max(promedio ord+extra últimos 11 meses, último salario base). Insumos: VAC_PAY_DAYS = días de vacación a pagar; VAC_PAY_AVG_11M = promedio de salarios ord+extra. Sujeto a CSS, SE, ISR como salario ordinario.</field>
    </record>

