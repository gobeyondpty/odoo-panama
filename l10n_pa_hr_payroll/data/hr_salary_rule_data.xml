    <record id="l10n_pa_rule_professional_risk_employer" model="hr.salary.rule">
        <field name="name">Riesgos Profesionales Employer (DG 68/1970)</field>
        <field name="code">RP_COMP</field>
        <field name="struct_id" ref="l10n_pa_payroll_structure_regular"/>
        <field name="category_id" ref="hr_payroll.COMP"/>
        <field name="sequence">420</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="appears_on_payslip">False</field>
        <field name="amount_python_compute">
company_rate = payslip.company_id.l10n_pa_professional_risk_rate(payslip.company_id)
fallback_rate = payslip._rule_parameter('l10n_pa_professional_risk_employer_rate')
rate = company_rate or fallback_rate
result = round(categories['GROSS'] * rate, 2)
        </field>
        <field name="note">Prima patronal de Riesgos Profesionales. DG 68/1970 arts. 48-51. La tasa = grado × 0.07 % asignado por CSS al empleador. Se resuelve primero del campo l10n_pa_css_risk_grade en res.company; si éste es cero, cae al parámetro global l10n_pa_professional_risk_employer_rate.</field>
    </record>

