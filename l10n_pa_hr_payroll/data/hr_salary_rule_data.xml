    <record id="l10n_pa_rule_income_tax_employee" model="hr.salary.rule">
        <field name="name">ISR Employee Withholding (DE 170/1993)</field>
        <field name="code">ISR_EMP</field>
        <field name="struct_id" ref="l10n_pa_payroll_structure_regular"/>
        <field name="category_id" ref="hr_payroll.DED"/>
        <field name="sequence">320</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
ded = 0.0
if inputs.get('SPOUSE_JOINT') and inputs['SPOUSE_JOINT'].amount:
    ded = payslip._rule_parameter('l10n_pa_isr_spouse_deduction')
result = -payslip.env['l10n.pa.hr.payroll.mixin'].monthly_income_tax(
    categories['GROSS'],
    int(payslip._rule_parameter('l10n_pa_income_tax_months')),
    ded,
)
        </field>
        <field name="note">Retención mensual del ISR per DE 170/1993 (Periodo Provisional de Cálculo). Anualiza la base × N + décimo proyectado, aplica tarifa art. 700 Cód. Fiscal, divide entre N. Insumo SPOUSE_JOINT activa la deducción de B/.800 por cónyuge (Cód. Fiscal art. 709 num. 1).</field>
    </record>

