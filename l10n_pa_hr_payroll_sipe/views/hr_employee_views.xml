<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_sipe" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.sipe</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']" position="inside">
                <group string="Panama / SIPE" name="l10n_pa_sipe">
                    <field name="l10n_pa_sipe_id_type"/>
                    <field name="l10n_pa_css_number"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
