<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_pa_sipe_export_wizard_form" model="ir.ui.view">
        <field name="name">l10n.pa.sipe.export.wizard.form</field>
        <field name="model">l10n.pa.sipe.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Exportar planilla SIPE">
                <group>
                    <group>
                        <field name="company_id" options="{'no_create': True}"/>
                        <field name="state" invisible="1"/>
                    </group>
                    <group>
                        <field name="date_start"/>
                        <field name="date_end"/>
                    </group>
                </group>
                <div invisible="state != 'done'">
                    <p>
                        Archivo SIPE generado. Descárguelo y súbalo en
                        <a href="https://sipe.css.gob.pa/" target="_blank">sipe.css.gob.pa</a>
                        bajo Ingresos → Planillas → Planilla Regular →
                        Cargar Archivo.
                    </p>
                    <field name="file_data" filename="file_name" readonly="1"/>
                    <field name="file_name" invisible="1"/>
                </div>
                <footer>
                    <button name="action_generate" string="Generar archivo SIPE"
                            type="object" class="btn-primary"
                            invisible="state == 'done'"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_pa_sipe_export" model="ir.actions.act_window">
        <field name="name">Exportar planilla SIPE</field>
        <field name="res_model">l10n.pa.sipe.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_l10n_pa_sipe_export"
              name="Exportar planilla SIPE"
              parent="hr_payroll.menu_hr_payroll_report"
              action="action_l10n_pa_sipe_export"
              sequence="50"/>
</odoo>
