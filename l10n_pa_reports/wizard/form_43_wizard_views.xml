<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_l10n_pa_form43_wizard" model="ir.ui.view">
        <field name="name">l10n_pa.form43.wizard.form</field>
        <field name="model">l10n_pa.form43.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar Formulario 43">
                <sheet>
                    <group>
                        <field name="company_id" options="{'no_create': True}"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group invisible="state != 'done'">
                        <field name="state" invisible="1"/>
                        <field name="invoice_count" readonly="1"/>
                        <field name="missing_concept_count" readonly="1"/>
                        <field name="file_name" readonly="1"/>
                        <field name="file_data" filename="file_name" readonly="1"/>
                    </group>
                    <div invisible="state != 'empty'" class="alert alert-warning">
                        No hay facturas de proveedor publicadas en el rango seleccionado para esta empresa.
                    </div>
                </sheet>
                <footer>
                    <button name="action_generate" type="object" string="Generar"
                            class="btn-primary" invisible="state == 'done'"/>
                    <button special="cancel" string="Cerrar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_pa_form43_wizard" model="ir.actions.act_window">
        <field name="name">Formulario 43 — Informe de Compras</field>
        <field name="res_model">l10n_pa.form43.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_l10n_pa_form43_wizard"
              name="Formulario 43 (Compras)"
              action="action_l10n_pa_form43_wizard"
              parent="account.account_reports_taxes_and_fiscal_menu"
              groups="account.group_account_readonly,account.group_account_basic"/>

</odoo>
